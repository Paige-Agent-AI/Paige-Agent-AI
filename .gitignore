# Claude Code local session state (settings + agent worktrees) — never commit,
# but DO version shared project commands under .claude/commands/ so every session
# (and every teammate) gets them.
#
# .claude/skills/ is versioned for the same reason: our own second-brain skill lives
# there and must reach every fresh container (§64). The third-party §69 skill is NOT vendored,
# because its bundle ships no LICENSE and its MIT notice can neither be fetched nor
# reconstructed without inventing a copyright holder.
# See .claude/skills/README.md before adding anything here.
.claude/*
!.claude/commands/
!.claude/skills/

# Live-drive helper screenshot artifacts — rendered PNGs are never committed (may contain
# authed-surface pixels); credentials are ENV-only and never written to disk. (scripts/live-drive)
scripts/live-drive/artifacts/
outputs/paige-scroll-verification/
outputs/paige-scroll-baseline/
outputs/paige-scroll-delayed-baseline/
deno.lock

# Rendered pack/app screenshots — regenerate with scripts/live-drive/pack-shoot.mjs
scripts/live-drive/artifacts/

# Vite writes a timestamped config shim next to any harness `vite.config.ts` it loads, so running
# ANY mount leaves one behind. It is a build temp, never a deliverable.
scripts/live-drive/harness/**/vite.config.ts.timestamp-*.mjs

# Harness scratch — one-off diagnostic scripts a render pass writes while it is running.
# Not deliverables: the harness's real outputs are its assertions and its labelled frames,
# and its frames already land in scripts/live-drive/artifacts/ above.
scripts/live-drive/harness/tmp/

# Transient probe scripts written into the drive folder by review agents and
# ad-hoc diagnosis. Scratch by convention — never a deliverable, and a blanket
# `git add -A` swept one into a commit once.
scripts/live-drive/zz-*

# Deno edge-ratchet evidence — CI artifacts, regenerated per run (77 of these were
# committed by accident in ec96762ea and only noticed when a local ratchet run
# reported them as deletions).
deno-ratchet-evidence/

# Campaigns Overview prototype — rendered PNG frames (8+ MB) are reproducible via
# `SHOOT=1 node docs/prototypes/campaigns-overview.drive.mjs`; the committed evidence
# record cites them and the repo keeps the script, not the binaries (house pattern).
docs/evidence/ui-delivery/campaigns-overview/
supabase/.temp/

# Impeccable (npm `impeccable`, Apache-2.0) ships a ~16MB PLATFORM-SPECIFIC engine binary
# per harness directory. Three harnesses are installed, so committing them would put ~48MB
# of linux-x64-only executable into every clone forever — dead weight on macOS and Windows,
# and a third-party binary in our history. The SKILL CONTENT (the markdown Impeccable exists
# to teach from) IS versioned; only the engine is ignored.
# Restore on any machine, and in CI before `impeccable detect`, with:
#   npx impeccable@<version> install --yes --project
.claude/skills/impeccable/scripts/bin/
.agents/skills/impeccable/scripts/bin/
.github/skills/impeccable/scripts/bin/

# Generated render harness page — 700KB of inlined compiled CSS, regenerated by
# src/solo/__render__/confirm-card.render.test.tsx. The PNGs beside it ARE tracked evidence.
docs/evidence/ui-delivery/solo-approval-executes/confirm-card.html
# Regenerated by src/solo/__render__/approval-recovery.render.test.tsx (it embeds the compiled CSS);
# the PNGs and render-results.json beside them are the tracked evidence.
docs/evidence/ui-delivery/solo-approval-recovery/*.html

# Impeccable working captures and throwaway approval frames — never shipped. The surface brief
# (.impeccable/surfaces/) and DESIGN.md are committed; screenshots and frame builds are not.
.impeccable/review/
.impeccable/frame/
.impeccable/build/
# The approved comp-led build record for Solo People contact methods is committed; comps not chosen are not.
.impeccable/mocks/decision/*
!.impeccable/mocks/decision/comp-a.png
!.impeccable/mocks/decision/comp-a.json
