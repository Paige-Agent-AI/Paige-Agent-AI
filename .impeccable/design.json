  "narrative": {
    "northStar": "The existing SOLO workspace",
    "overview": "This is an extraction of the incumbent Obsidian and Mineral workspace, not a new visual identity. Its boundary is the sampled native Chat, Calendar, Operations and weekly responsibility UI. It supplies no design authority for unseen product areas, the public site, Studio or other shells.\n\nSchibsted Grotesk, warm ink, quiet tonal layers and compact controls keep the working surface readable. The weekly extension fits this language with plain divided rows, a familiar right sheet and explicit status text. The existing direction contract supplies the identity; no new metaphor or branding has been chosen.",
    "keyCharacteristics": [
      "Two separately authored themes, selected through the existing theme root.",
      "Tonal workspace depth and restrained seams.",
      "Compact working controls with visible keyboard focus.",
      "Original work stays in its existing native surface."
    ],
    "rules": [
      {
        "name": "The Theme Root Rule",
        "body": "Resolve component color through the existing `--pg-*` theme root; preserve each theme's authored roles.",
        "section": "colors"
      },
      {
        "name": "The Prose Figures Rule",
        "body": "Keep tabular numerals on figures rather than prose; the global stylesheet explicitly records why full-width punctuation must not spread into sentences.",
        "section": "typography"
      },
      {
        "name": "The Existing Depth Rule",
        "body": "Select the incumbent layer or elevation needed by the component; do not invent a new palette to distinguish a native sheet or menu.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do inherit the existing theme, face and layer vocabulary.",
      "Do preserve readable state words, wrapping identifiers and explicit scroll ownership.",
      "Do preserve the native library icons and visible focus treatment.",
      "Do keep local weekly sizes and shapes scoped to that component family."
    ],
    "donts": [
      "Don't apply this sampled record as authority for unseen product areas.",
      "Don't turn an inspection or proposal control into a gold completion signal merely for decoration.",
      "Don't promote pre-existing contrast, focus or typography drift into a reusable rule."
    ]
  }
}
